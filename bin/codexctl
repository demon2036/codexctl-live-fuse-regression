#!/bin/sh
set -eu

SELF=$0
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF=$LINK ;;
    *) SELF=$(dirname -- "$SELF")/$LINK ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
NODE_BIN=${CODEXCTL_NODE:-}

if [ -z "$NODE_BIN" ]; then
  NODE_BIN=$(command -v node || true)
fi

if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "codexctl: Node.js 22+ was not found" >&2
  exit 127
fi

exec "$NODE_BIN" "$SCRIPT_DIR/codexctl.mjs" "$@"
