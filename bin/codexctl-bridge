#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NODE_BIN=${CODEXCTL_NODE:-}

if [ -z "$NODE_BIN" ]; then
  NODE_BIN=$(command -v node || true)
fi

if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "codexctl bridge: Node.js 20+ was not found" >&2
  exit 127
fi

exec "$NODE_BIN" "$SCRIPT_DIR/../bridge/codexctl-bridge.mjs" "$@"
