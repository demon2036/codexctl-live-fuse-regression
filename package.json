{
  "name": "codexctl-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform macOS/Linux controller for Codex Desktop context, prompt, wallpaper, and ephemeral relay launches.",
  "bin": {
    "codexctl": "./bin/codexctl.mjs"
  },
  "scripts": {
    "catalog": "node ./scripts/catalog-summary.mjs --write",
    "check": "node ./scripts/check.mjs",
    "test": "node --test",
    "test:app": "node ./scripts/app-regression.mjs",
    "test:browser": "node ./scripts/browser-regression.mjs",
    "test:fast": "node ./scripts/fast-regression.mjs",
    "test:performance": "node ./scripts/performance-regression.mjs",
    "test:platform": "node ./scripts/platform-regression.mjs",
    "test:regression": "node ./scripts/regression.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
